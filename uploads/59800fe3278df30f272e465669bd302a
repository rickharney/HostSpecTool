openapi: 3.1.0
info:
  title: Pick Order Assortment Update API
  version: 1.0.0
  description: 'A Pick Order Assortment Update message updates the original pick order with the assortment SKU, amount, and
    destination. Data direction: From WES.'
paths:
  /pick-order-assortment-update:
    post:
      operationId: pickOrderAssortmentUpdate
      summary: Process a Pick Order Assortment Update message
      description: Updates the original pick order with the assortment SKU, amount, and destination.
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PickOrderAssortmentUpdateRequest'
            examples:
              sample:
                value:
                  pickOrderAssortmentUpdate:
                    messageId: 8540d774-4863-4d2b-b788-4ecb19412e85
                    messageTimestamp: '2019-08-24T14:15:22Z'
                    pickOrderId: string
                    skuId: string
                    quantity: 0
      responses:
        '200':
          description: Message processed successfully
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AcknowledgementResponse'
              examples:
                success:
                  value:
                    success: true
                    details: null
        '400':
          description: Message failed
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AcknowledgementResponse'
              examples:
                success:
                  value:
                    success: false
                    details: Message rejected because of formatting issue
        '500':
          description: Message failed
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AcknowledgementResponse'
              examples:
                success:
                  value:
                    success: false
                    details: Exception processing the message
components:
  schemas:
    PickOrderAssortmentUpdateRequest:
      type: object
      required:
      - pickOrderAssortmentUpdate
      properties:
        pickOrderAssortmentUpdate:
          $ref: '#/components/schemas/PickOrderAssortmentUpdate'
    PickOrderAssortmentUpdate:
      type: object
      required:
      - messageId
      - messageTimestamp
      - pickOrderId
      - skuId
      - quantity
      properties:
        messageId:
          type: string
          maxLength: 36
          description: UUID
        messageTimestamp:
          type: string
          format: date-time
          description: Timestamp when the message was created
        pickOrderId:
          type: string
          maxLength: 20
          description: Unique identifier for this Pick Order
        skuId:
          type: string
          maxLength: 20
          description: Unique Item Id
        quantity:
          type: integer
          description: Number of items assembled
    AcknowledgementResponse:
      type: object
      required:
      - success
      - details
      properties:
        success:
          type: boolean
        details:
          type:
          - string
          - 'null'
