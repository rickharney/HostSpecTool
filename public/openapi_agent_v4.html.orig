<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Confluence → OpenAPI 3.1 Agent</title><style>
:root{font-family:system-ui,Segoe UI,Arial,sans-serif;background:#f3f6fb;color:#17233a}*{box-sizing:border-box}body{margin:0}.wrap{max-width:1250px;margin:26px auto;padding:0 18px}h1{font-size:27px;margin:8px 0}p{color:#526078}.layout{display:grid;grid-template-columns:1fr 1fr;gap:18px}.panel{background:white;border:1px solid #dce3ee;border-radius:12px;padding:20px}h2{font-size:18px;margin:0 0 12px}label{display:block;font-weight:650;margin:13px 0 6px;font-size:13px}textarea,input,select{font:inherit;border:1px solid #cbd5e1;border-radius:7px;padding:10px;width:100%;background:white;color:#17233a}textarea{resize:vertical;font-family:Consolas,monospace;font-size:12px}#source{height:520px}#yaml{height:520px}.pair{display:grid;grid-template-columns:1fr 1fr;gap:10px}.actions{display:flex;gap:9px;flex-wrap:wrap;margin-top:13px}button{border:0;border-radius:7px;padding:11px 14px;background:#2357cc;color:white;font-weight:650;cursor:pointer}button.secondary{background:#e9eff9;color:#173a7b}button:disabled{opacity:.5;cursor:not-allowed}.hint,.status{font-size:12px;color:#64748b;margin-top:9px;white-space:pre-wrap}.error{color:#b42318}.ok{color:#157347}.pill{display:inline-block;background:#e9f1ff;color:#1e4ca3;border-radius:20px;padding:5px 10px;font-size:12px;font-weight:650}details{margin-top:14px}summary{cursor:pointer;font-weight:650}#analysis{font-size:12px;line-height:1.6;white-space:pre-wrap;background:#f7f9fd;padding:10px;border-radius:8px;margin-top:10px}@media(max-width:850px){.layout{grid-template-columns:1fr}#source,#yaml{height:400px}}</style></head><body><main class="wrap"><header><span class="pill">Browser-only • OpenAPI 3.1</span><h1>Confluence → OpenAPI Agent</h1><p>Paste the entire Confluence service specification into one box. The agent extracts the name, description, field metadata, and JSON sample.</p></header><div class="layout"><section class="panel"><h2>1. Paste Confluence content</h2><label for="source">Full service specification</label><textarea id="source" spellcheck="false" placeholder="Paste the service title, description, field table and example JSON here..."></textarea><div class="actions"><button id="generate">Analyze &amp; Generate YAML</button></div><details><summary>Optional endpoint settings</summary><div class="pair"><div><label for="method">HTTP method</label><select id="method"><option>POST</option><option>PUT</option><option>PATCH</option><option>GET</option><option>DELETE</option></select></div><div><label for="path">Endpoint path (blank = infer)</label><input id="path" placeholder="/wave-order-request"></div></div><label for="server">Server URL (optional)</label><input id="server" placeholder="https://api.example.com"></details><div id="status" class="status" role="status"></div><details open><summary>Extracted information / review</summary><div id="analysis">Generate to see what was detected.</div></details></section><section class="panel"><h2>2. Generated OpenAPI YAML</h2><textarea id="yaml" spellcheck="false" aria-label="Generated OpenAPI YAML"></textarea><div class="actions"><button id="download" disabled>Download .yaml</button><button id="copy" class="secondary" disabled>Copy YAML</button></div><p class="hint">The 200, 400, and 500 responses use the shared AcknowledgementResponse schema. Review inferred metadata and the endpoint before publishing.</p></section></div></main><script>
const $=id=>document.getElementById(id);
function quote(s){return JSON.stringify(String(s))}function scalar(v){if(v===null)return 'null';if(typeof v==='string')return quote(v);if(typeof v==='number'||typeof v==='boolean')return String(v);return quote(String(v))}
function yamlDump(value,indent=0){const pad=' '.repeat(indent);if(Array.isArray(value)){if(!value.length)return '[]';return value.map(v=>{if(v&&typeof v==='object'&&Object.keys(v).length){const body=yamlDump(v,indent+2).split('\n');return pad+'- '+body[0].trimStart()+(body.length>1?'\n'+body.slice(1).join('\n'):'')}return pad+'- '+yamlDump(v,indent+2)}).join('\n')}if(value&&typeof value==='object'){const entries=Object.entries(value);if(!entries.length)return '{}';return entries.map(([k,v])=>{const key=/^[A-Za-z_][A-Za-z0-9_-]*$/.test(k)?k:quote(k);if(v&&typeof v==='object'&&Object.keys(v).length)return pad+key+':\n'+yamlDump(v,indent+2);return pad+key+': '+yamlDump(v,indent+2)}).join('\n')}return scalar(value)}
function infer(v){if(v===null)return {type:'null'};if(Array.isArray(v))return {type:'array',items:v.length?infer(v[0]):{}};if(typeof v==='object'){const properties={};for(const [k,x] of Object.entries(v))properties[k]=infer(x);return {type:'object',properties,required:Object.keys(v),additionalProperties:false}}if(typeof v==='number')return {type:Number.isInteger(v)?'integer':'number'};return {type:typeof v}}
function applyOverride(schema,path,type,description){const parts=path.split('.').map(x=>x.trim()).filter(Boolean);if(!parts.length)return;let cur=schema;for(let i=0;i<parts.length;i++){if(cur.type==='array')cur=cur.items;if(cur.type!=='object'){cur.type='object';cur.properties={};delete cur.items}cur.properties??={};const k=parts[i];cur.properties[k]??={type:'string'};if(i===parts.length-1){if(type!=='auto'){cur.properties[k].type=type;if(type==='object')cur.properties[k].properties??={};if(type==='array')cur.properties[k].items??={type:'string'};if(type!=='object')delete cur.properties[k].properties;if(type!=='array')delete cur.properties[k].items}if(description)cur.properties[k].description=description}else cur=cur.properties[k]}}

function extractJSON(s){let start=-1,depth=0,inString=false,escape=false;for(let i=0;i<s.length;i++){const c=s[i];if(start<0){if(c==='{'||c==='['){start=i;depth=1}continue}if(inString){if(escape)escape=false;else if(c==='\\')escape=true;else if(c==='"')inString=false;continue}if(c==='"')inString=true;else if(c==='{'||c==='[')depth++;else if(c==='}'||c===']'){depth--;if(depth===0){const candidate=s.slice(start,i+1);try{return {value:JSON.parse(candidate),start,end:i+1}}catch(e){start=-1}}}}throw Error('No valid JSON object or array found in the pasted text. Include a complete sample payload.');}
function parseRows(s){const lines=s.split(/\r?\n/).map(x=>x.trim()).filter(Boolean),rows=[];const idx=/^\d+(?:\.\d+)*\.?$/;for(let i=0;i<lines.length;i++){if(!idx.test(lines[i]))continue;let j=i+1;if(j>=lines.length||!/^[$A-Za-z_][\w$-]*$/.test(lines[j]))continue;const name=lines[j++];let tokens=[];while(j<lines.length&&!idx.test(lines[j])&&!/^Sample\b/i.test(lines[j])&&tokens.length<12){tokens.push(lines[j++])}const yes=tokens.findIndex(x=>/^(yes|no)$/i.test(x));if(yes<0)continue;const before=tokens.slice(0,yes);const known=/^(root element|datetime|date|integer|int|long|double|float|decimal|number|string|boolean|bool|object|array|list\s*<[^>]+>)$/i;let type='',desc='';if(before.length&&known.test(before[0])){type=before[0];desc=before.slice(1).join(' ')}else desc=before.join(' ');rows.push({index:lines[i],name,type,description:desc,required:/^yes$/i.test(tokens[yes])});i=j-1}return rows}
function matchType(raw){const t=raw.trim().toLowerCase();if(!t||t==='root element')return null;if(t==='datetime')return {type:'string',format:'date-time'};if(t==='date')return {type:'string',format:'date'};if(['int','integer','long'].includes(t))return {type:'integer'};if(['float','double','decimal','number'].includes(t))return {type:'number'};if(['bool','boolean'].includes(t))return {type:'boolean'};if(t==='string')return {type:'string'};if(t.startsWith('list<')){const inner=t.slice(5,-1);return {type:'array',items:matchType(inner)||{type:'object'}}}if(t==='array')return {type:'array',items:{}};if(t==='object')return {type:'object'};return {type:'object'}}
function walkSchema(schema,parts){let cur=schema;for(const part of parts){if(cur.type==='array')cur=cur.items;if(!cur||cur.type!=='object'||!cur.properties||!cur.properties[part])return null;cur=cur.properties[part]}return cur}
function locate(schema,name){const hits=[];function visit(node,path){if(!node||typeof node!=='object')return;if(node.type==='array')visit(node.items,path);if(node.properties)for(const [k,v] of Object.entries(node.properties)){if(k===name)hits.push({node:v,parent:node,key:k,path:[...path,k]});visit(v,[...path,k])}}visit(schema,[]);return hits}
function applyRows(schema,rows){const warnings=[];for(const row of rows){const hits=locate(schema,row.name);if(!hits.length){warnings.push('Field not found in sample: '+row.name);continue}if(hits.length>1)warnings.push('Ambiguous repeated field: '+row.name);for(const hit of hits){const type=matchType(row.type);if(type){if(type.type===hit.node.type){if(type.format)hit.node.format=type.format;if(type.type==='array'&&hit.node.items&&type.items.type!=='object'&&type.items.type!==hit.node.items.type)warnings.push('Array item type mismatch: '+row.name)}else warnings.push('Type mismatch for '+row.name+': table='+row.type+', JSON='+hit.node.type)}if(row.description)hit.node.description=row.description;const req=hit.parent.required||[];hit.parent.required=row.required?[...new Set([...req,hit.key])]:req.filter(x=>x!==hit.key)}}return warnings}
function makeResponses(){const result={};for(const [status,desc,success,details] of [['200','Message processed successfully',true,null],['400','Message failed',false,'Message rejected because of formatting issue'],['500','Message failed',false,'Exception processing the message']])result[status]={description:desc,content:{'application/json':{schema:{$ref:'#/components/schemas/AcknowledgementResponse'},examples:{success:{value:{success,details}}}}}};return result}
function generate(){try{const s=$('source').value.trim();if(!s)throw Error('Paste the Confluence specification first.');const found=extractJSON(s);const prefix=s.slice(0,found.start),rows=parseRows(prefix);const intro=prefix.split(/\r?\n/).map(x=>x.trim()).filter(Boolean);const title=intro[0]||'Imported JSON Service';let desc=[];for(let i=1;i<intro.length;i++){if(/^\d+(?:\.\d+)*\.?$/.test(intro[i])||/^Sample\b/i.test(intro[i]))break;desc.push(intro[i])}const description=desc.join(' ')||title;const payload=found.value;let schema=infer(payload);const warnings=applyRows(schema,rows);const method=$('method').value.toLowerCase();const path=$('path').value.trim()||'/'+title.toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'');if(!path.startsWith('/'))throw Error('Endpoint must start with /.');const server=$('server').value.trim();if(server){const url=new URL(server);if(!['http:','https:'].includes(url.protocol))throw Error('Server must use http or https.')}const operation={summary:title,description,operationId:title.replace(/[^A-Za-z0-9]+/g,' ').trim().split(' ').map((x,i)=>i?x[0].toUpperCase()+x.slice(1):x.toLowerCase()).join(''),...( ['post','put','patch'].includes(method)?{requestBody:{required:true,content:{'application/json':{schema,example:payload}}}}:{}),responses:makeResponses()};const spec={openapi:'3.1.0',info:{title,version:'1.0.0',description},...(server?{servers:[{url:server}]}:{}),paths:{[path]:{[method]:operation}},components:{schemas:{AcknowledgementResponse:{type:'object',properties:{success:{type:'boolean'},details:{type:['string','null']}},required:['success','details']}}}};$('yaml').value=yamlDump(spec)+'\n';$('download').disabled=false;$('copy').disabled=false;$('analysis').textContent='Title: '+title+'\nDescription: '+description+'\nMethod: '+method.toUpperCase()+'\nPath: '+path+' (inferred if not supplied)\nRoot JSON keys: '+Object.keys(payload).join(', ')+'\nFields found in Confluence table: '+rows.length+'\n'+rows.map(r=>'• '+r.name+' | '+(r.type||'inferred')+' | required='+r.required+(r.description?' | '+r.description:'')).join('\n')+(warnings.length?'\n\nReview warnings:\n'+warnings.map(x=>'• '+x).join('\n'):'')+'\n\nNote: endpoint, method and requiredness should be verified against your actual service contract.';$('status').textContent='YAML generated. '+rows.length+' field definitions extracted.'+(warnings.length?' '+warnings.length+' warning(s) to review.':'');$('status').className='status ok';}catch(e){$('status').textContent=e.message;$('status').className='status error'}}
$('generate').onclick=generate;$('download').onclick=()=>{const blob=new Blob([$('yaml').value],{type:'application/yaml;charset=utf-8'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download='openapi-3.1.yaml';document.body.append(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),1000)};$('copy').onclick=async()=>{try{await navigator.clipboard.writeText($('yaml').value);$('status').textContent='YAML copied.'}catch(e){$('yaml').select();document.execCommand('copy');$('status').textContent='Select and copy the YAML.'}};
</script></body></html>